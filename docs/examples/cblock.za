* CBLOCK language and intrinsic examples.  This file only assembles; it is
* not a runnable program.  Expected values are in the comments.
PARM     DSECT
P_FLAGS  DS    F
P_NAME   DS    CL4
P_SIZE   DS    D

CBLOCK   CSECT
         USING CBLOCK,%r12
         LARL  %r12,CBLOCK
         LARL  %r10,TEMP1
         LHI   %r2,5
         LHI   %r3,7

#pragma cblock arithmetic
#pragma cin int32_t a=%r2, int32_t b=%r3
#pragma cout int32_t sum=%r4
#pragma cscratch %r0, %r1, %r5, %r6
#pragma ctemp %r10, 128, down
#pragma cbegin
    int32_t i;
    int32_t t = 0;

    for (i = 0; i < a; i++) {
        if (i == 2)
            continue;
        t += b;                 /* 5 iterations, one skipped: 28 */
    }
    switch (t) {
    case 28:
        t += 1;                 /* 29 */
        break;
    default:
        t = 0;
    }
    sum = t;
#pragma cend

* Dereference and address of a local.
         LARL  %r10,TEMP3
#pragma cblock pointers
#pragma cout int32_t value=%r4
#pragma cscratch %r0, %r1, %r5, %r6
#pragma ctemp %r10, 128, down
#pragma cbegin
    int32_t x = 65;
    uint8_t *q;

    q = &x;
    *q = 66;                    /* writes the low byte of x */
    value = x;                  /* 66 */
#pragma cend

* Opaque named pointer and the assembler size/offset lookups.
         LARL  %r10,TEMP4
#pragma cblock typed
#pragma cout int32_t size=%r4, PARM *out=%r5
#pragma cscratch %r0, %r1, %r6, %r7
#pragma ctemp %r10, 128, down
#pragma cbegin
    PARM *p;
    int32_t x = 65;
    int32_t *ip;

    p = (PARM *)0;
    out = p;
    ip = &x;
    *ip = 66;
    size = (int32_t)__sizeof(PARM) + (int32_t)__offsetof(PARM, P_NAME) + *ip;
#pragma cend

* Address of a DSECT element: byte pointer plus __offsetof.
* A named pointer has no p->field, so compute the field address by hand.
         LARL  %r2,PARM_AREA
         LARL  %r10,TEMP5
#pragma cblock dsect
#pragma cin PARM *parm=%r2
#pragma cout int32_t flags=%r4
#pragma cscratch %r0, %r1, %r5, %r6
#pragma ctemp %r10, 128, down
#pragma cbegin
    uint8_t *base;
    uint32_t *pf;

    base = (uint8_t *)parm;                              /* opaque -> byte pointer */
    pf = (uint32_t *)(base + __offsetof(PARM, P_FLAGS)); /* &parm->P_FLAGS */
    *pf = 12;                                            /* write P_FLAGS */
    base[__offsetof(PARM, P_NAME)] = 88;                 /* &parm->P_NAME[0] */
    flags = (int32_t)*pf;                                /* 12 */
#pragma cend

* Pointer arithmetic and every memory/scan intrinsic.
         LARL  %r2,SRC
         LARL  %r3,DST
         LARL  %r10,TEMP2
#pragma cblock memory
#pragma cin uint8_t *s=%r2, uint8_t *d=%r3
#pragma cout int32_t n=%r4
#pragma cscratch %r0, %r1, %r5, %r6, %r7
#pragma ctemp %r10, 128, down
#pragma cbegin
    uint8_t *q;

    n = (int32_t)__strlen(s);   /* 5 */
    q = __memchr(s, 67, n);     /* pointer to 'C', offset 2 */
    n += (q != 0);              /* 6 */
    __memcpy(d, s, n);          /* ABCDEx */
    __memmove(d + 1, d, n - 1); /* shift right by one */
    __memset(d, 65, 1);         /* 'A' */
#pragma cend

         DS    0H
SRC      DC    C'ABCDE',X'00'
         DS    0H
DST      DS    CL16
         DS    0D
PARM_AREA DS   CL16
         DS    0D
TEMP1    DS    128D
TEMP2    DS    128D
TEMP3    DS    128D
TEMP4    DS    128D
TEMP5    DS    128D
         LTORG
         END   CBLOCK
